let twopi = 6.283185307179586

fn phasor(freq: float) {
  (self + freq / samplerate) % 1.0
}

fn dsp() {
  let carrier = Control!("Carrier", 220.0)
  let ratio = Control!("Ratio", 2.0)
  let index = Control!("Index", 120.0)
  let gain = Control!("Gain", 0.14)

  let modf = sin(phasor(carrier * ratio) * twopi) * index
  let left = sin(phasor(carrier + modf) * twopi) * gain
  let right = sin(phasor(carrier * 1.01 + modf) * twopi) * gain
  (left, right)
}
